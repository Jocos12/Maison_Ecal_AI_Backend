# Modèle de configuration du backend M-ECAL.
# Copier ce fichier en `.env` (jamais commité) puis remplir les valeurs.

# --- Serveur ---
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
DOTENV_PATH=

# --- Base de données (obligatoire en production) ---
MONGODB_URI=mongodb://127.0.0.1:27017/mecal_monitor

# --- Sécurité (obligatoire) — valeurs longues et aléatoires, ex. `openssl rand -hex 32` ---
JWT_SECRET=
JWT_EXPIRES_IN=24h
CRON_SECRET=
OTP_PEPPER=
RESET_TOKEN_PEPPER=
AUTH_REQUIRE_OTP=true

# --- Premier administrateur (créé seulement si la base est vide) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
ADMIN_NOTIFY_EMAIL=

# --- Fournisseurs d'IA (au moins une clé pour les fonctions IA) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_TTS_MAX_CHARS=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_LITE_MODEL=
AI_SKIP_PROVIDERS=
AI_DISABLE_CLAUDE=
AI_RECOVERY_PROBE_MS=45000

# --- E-mail via Gmail API (OAuth2) ---
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/gmail/callback
GMAIL_REFRESH_TOKEN=

# --- E-mail via SMTP (alternative à Gmail API) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ALERT_WHATSAPP_TO=

# --- Veille / robots de collecte ---
SCRAPE_CRON=
NRC_CRON=
NRC_DISABLED=false
DEVEX_DISABLED=false
RELIEFWEB_APPNAME=
RELIEFWEB_RSS_URL=
USER_AGENT=
JOB_SCRAPER_USER_AGENT=
PUPPETEER_EXECUTABLE_PATH=
TESSERACT_PATH=
OCR_CONCURRENCY=4

# --- Réglages fins de la veille (facultatif, valeurs par défaut dans le code) ---
SCRAPE_SAFETY_NET_MS=
SCRAPE_STARTUP_DELAY_MS=
SCRAPE_STARTUP_MAX_AGE_MS=
SCRAPE_STALE_AFTER_MS=
SCRAPE_CRITICAL_AFTER_MS=
SCAN_TIMEOUT_MS=
NRC_STARTUP_DELAY_MS=
NRC_CRAWL_DELAY_MS=
NRC_SKIP_ATTACHMENTS=
NRC_MAX_TENDER_DETAILS=
NRC_MAX_JOB_DETAILS=
NRC_MAX_AI_SCORES=
IRC_MAX_DETAILS=
ICRC_MAX_DETAILS=
DRCNGO_MAX_DETAILS=
UNGM_SCRAPE_LIMIT=
UNGM_DRC_COUNTRY_ID=
ARMP_DETAIL_CONCURRENCY=
JOB_SOURCE_TIMEOUT_MS=
JOB_SOURCE_CIRCUIT_FAILURES=
JOB_SOURCE_CIRCUIT_COOLDOWN_MS=
JOB_SCRAPE_CACHE_TTL_MS=
STALE_NO_DEADLINE_DAYS=
NEW_OPPORTUNITY_DAYS=
HIGH_RELEVANCE_THRESHOLD=
MECAL_MATCH_PROFILE=

# --- Certificats TLS — à laisser vides (true) ; « false » seulement pour dépanner ---
SCRAPER_TLS_REJECT_UNAUTHORIZED=
SMTP_TLS_REJECT_UNAUTHORIZED=
GMAIL_TLS_REJECT_UNAUTHORIZED=
AI_TLS_REJECT_UNAUTHORIZED=
OPENAI_TLS_REJECT_UNAUTHORIZED=
